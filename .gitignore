# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 시크릿(Supabase 키, 카카오맵 키 등)은 커밋하지 않는다.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 수집 데이터 — 저장소는 퍼블릭이지만 데이터는 공개하지 않는다.
# 공공데이터/UGC 정제 결과물이라 그대로 복사될 수 있다.
# 타입 정의와 샘플만 공개하고, 완성 데이터셋은 Supabase에 둔다.
/data/
/scripts/output/
*.dataset.json

# Claude 로컬 설정
.claude/settings.local.json
.mcp.json

# Supabase 로컬
/supabase/.branches
/supabase/.temp

# IDE (Android Studio·IntelliJ) — 머신 종속 설정이라 추적하지 않는다
.idea/
*.iml
