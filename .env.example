# 실제 값은 .env.local 에 둔다 (.env* 는 커밋 금지, 이 파일만 예외).

# Supabase — 프로젝트 대시보드 > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google OAuth — "웹 애플리케이션" 유형 클라이언트 ID (공개 값, 네이티브 serverClientId 겸용)
# 클라이언트 비번(secret)은 앱에 필요 없다 — Supabase 대시보드(Auth > Providers > Google)에만 넣는다.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
