# 실제 값은 .env.local 에 둔다 (.env* 는 커밋 금지, 이 파일만 예외).

# Supabase — 프로젝트 대시보드 > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google OAuth — "웹 애플리케이션" 유형 클라이언트 ID (공개 값, 네이티브 serverClientId 겸용)
# 클라이언트 비번(secret)은 앱에 필요 없다 — Supabase 대시보드(Auth > Providers > Google)에만 넣는다.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# 인증 E2E 전용 계정 (선택). 없으면 authenticated 프로젝트는 건너뛰고 나머지는 그대로 돈다.
# 앱의 로그인 수단은 Google OAuth 뿐이라 이 계정은 UI 로 만들 수 없다 —
# Supabase 대시보드 > Authentication > Users > Add user 에서 "Auto Confirm User" 를
# 켜고 만든다. 실제 사람이 쓰는 주소를 넣지 않는다.
E2E_USER_EMAIL=e2e@example.test
E2E_USER_PASSWORD=
