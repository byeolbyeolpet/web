{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm run *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git remote *)",
      "Bash(git fetch *)",
      "Bash(gh repo view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_extensions",
      "mcp__supabase__list_migrations",
      "mcp__supabase__get_advisors",
      "mcp__supabase__get_project_url",
      "mcp__supabase__list_edge_functions",
      "mcp__supabase__search_docs"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "BRANCH=$(git branch --show-current 2>/dev/null); printf '작업 재개 컨텍스트 — 브랜치: %s | 진행 중 이슈의 번호·완료조건을 먼저 확인 | 저자 규칙: Claude 작업 커밋=Claude 저자(제목 /Claude), 지호님 수정 코드=사용자 저자 | GitFlow: main=릴리스, dev=기본·통합, PR은 rebase 머지만 | 규칙 출처: CLAUDE.md·AGENTS.md·docs/conventions\\n' \"$BRANCH\""
          }
        ]
      }
    ]
  }
}
