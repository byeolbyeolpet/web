{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm run *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git remote *)",
      "Bash(git fetch *)",
      "Bash(gh repo view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_extensions",
      "mcp__supabase__list_migrations",
      "mcp__supabase__get_advisors",
      "mcp__supabase__get_project_url",
      "mcp__supabase__list_edge_functions",
      "mcp__supabase__search_docs"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "BRANCH=$(git branch --show-current 2>/dev/null); printf '현재 브랜치: %s — 브랜치명의 #이슈에서 완료조건을 확인\\n' \"$BRANCH\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c 'if ((.tool_input.command // \"\") | test(\"gh[[:space:]]+pr[[:space:]]+create\")) then {hookSpecificOutput:{hookEventName:\"PostToolUse\",additionalContext:\"PR을 생성했다. README.md 의 진행 상황 섹션을 이번 PR 내용에 맞게 갱신하라 — 완료된 항목 체크, 새로 추가된 스키마·기능·문서 반영, 다음 작업 항목 갱신. 이미 갱신했거나 갱신할 것이 없으면 그 사유를 한 줄로 밝힌다.\"}} else empty end'"
          }
        ]
      }
    ]
  }
}
